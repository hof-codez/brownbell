# Copy this file to .env and fill in your real values.
# Find both on your Supabase project: Settings -> API.
# VITE_SUPABASE_ANON_KEY is the public "anon" key - safe to ship in a built
# frontend. Never put the service_role key here; that one stays server-side
# only (the automation's GitHub secret), never in this app.

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
